{
  "name": "shannon",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:mcp": "npm --prefix mcp-server run build",
    "build:ui": "bun run --cwd ui build",
    "test": "bun test tests",
    "audit:dependencies": "npm audit --audit-level=high --omit=optional",
    "temporal:server": "docker compose -f docker/docker-compose.temporal.yml up temporal -d",
    "temporal:server:stop": "docker compose -f docker/docker-compose.temporal.yml down",
    "temporal:worker": "node dist/temporal/worker.js",
    "temporal:start": "node dist/temporal/client.js",
    "temporal:query": "node dist/temporal/query.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@temporalio/activity": "^1.21.1",
    "@temporalio/client": "^1.21.1",
    "@temporalio/worker": "^1.21.1",
    "@temporalio/workflow": "^1.21.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "boxen": "^8.0.1",
    "chalk": "^5.0.0",
    "dotenv": "^16.4.5",
    "figlet": "^1.9.3",
    "gradient-string": "^3.0.0",
    "js-yaml": "^4.3.0",
    "zod": "^3.22.4",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "fast-uri": "3.1.4",
    "protobufjs": "7.6.5",
    "serialize-javascript": "7.0.7",
    "uuid": "11.1.1"
  }
}
